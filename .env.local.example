# Copy to .env.local for local dev, or set these in the Vercel project.
# Everything here is SERVER-SIDE ONLY — no NEXT_PUBLIC_ on the calendar values,
# so endpoints and tokens never reach the browser.

# Absolute origin, used for metadata and for the links in the proposals.
NEXT_PUBLIC_SITE_ORIGIN=

# Overrides GRIMHART's WhatsApp number (E.164, digits only) for the proposal
# CTAs. The current number is the default in src/factory/grimhart.ts, so this
# only needs setting if it changes.
NEXT_PUBLIC_GRIMHART_WHATSAPP=

# Default Google Apps Script calendar endpoint for every lead.
# Unset falls back to the shared GRIMHART demo endpoint.
CALENDAR_ENDPOINT_URL=
CALENDAR_TOKEN=

# Per-lead overrides. <REF> is the lead's booking.calendarRef, upper-cased.
# CALENDAR_ENDPOINT_URL_SOUSA=
# CALENDAR_TOKEN_SOUSA=

# Optional: Google Maps Embed API key. Without it the maps use the keyless
# embed, which works fine — the key just removes the Google branding overlay.
NEXT_PUBLIC_MAPS_EMBED_KEY=
