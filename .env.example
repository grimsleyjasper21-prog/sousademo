# GRIMHART Outreach Engine — copy to .env.local for local dev, or set in your
# hosting provider's environment variables. Never commit real secrets.

# Supabase project (Settings -> API in your Supabase dashboard)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only — never exposed to the browser. Used for all reads/writes.
SUPABASE_SERVICE_ROLE_KEY=

# Anthropic (server-only, used for AI message generation)
ANTHROPIC_API_KEY=
# Optional — defaults to claude-sonnet-5
ANTHROPIC_MODEL=

# Set to "true" to use the built-in mock message generator instead of calling
# the Anthropic API (also used automatically in development when
# ANTHROPIC_API_KEY is unset). Never leave this "true" in production.
AI_MOCK_MODE=false
